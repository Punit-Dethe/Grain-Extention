# The registry's own ignore. Secret signing keys NEVER live here (they stay in
# the maintainer's registry-keys/ outside any repo, and move to removable media
# at launch). This is a safety net.
*.key
registry-keys/

# Dev hosting: the whole v1/ tree (index, sigs, and content-addressed blobs) is
# committed and served over raw.githubusercontent.com, which supports paths.
# (Production may move to GitHub Releases / Pages — a signed roots.json change,
# not an app change, since base URLs live in the signed roots.)

# Generated public site output.
site/dist/
node_modules/
