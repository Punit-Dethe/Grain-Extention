{
  "id": "grain.app-modes",
  "name": "App Modes",
  "version": "1.0.1",
  "grainApi": "^1.0",
  "tier": "scripted",
  "description": "Format what you dictate differently in each app or website.",
  "repository": "https://github.com/Punit-Dethe/Grain-Extention",
  "entry": "main.js",
  "permissions": [
    "transform:transcript",
    "capture:app",
    "llm",
    "settings"
  ],
  "activation": [
    "onTransform"
  ],
  "contributes": {
    "settings": [
      {
        "key": "modes-card",
        "label": "",
        "kind": "panel",
        "uiSource": "config.html",
        "searchTerms": [
          "modes",
          "app mode",
          "context",
          "per app",
          "formatting"
        ],
        "anchor": "context.after",
        "order": 10
      }
    ]
  }
}
