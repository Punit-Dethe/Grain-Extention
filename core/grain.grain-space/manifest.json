{
  "id": "grain.grain-space",
  "name": "Grain Space",
  "version": "1.0.0",
  "grainApi": "^1.0",
  "tier": "builtin",
  "description": "A local, searchable notebook: save what you dictate and ask questions across all of it.",
  "repository": "https://github.com/Punit-Dethe/Grain",
  "permissions": [
    "capture:selection",
    "storage",
    "settings",
    "llm",
    "embed"
  ],
  "contributes": {
    "settings": [
      {
        "key": "grain-space",
        "label": "",
        "kind": "panel",
        "uiSource": "grain://grain-space/settings",
        "searchTerms": [
          "notes",
          "grain space",
          "note",
          "vault",
          "obsidian",
          "recall",
          "memory",
          "second brain",
          "reminders",
          "quick add",
          "semantic search",
          "embeddings"
        ],
        "order": 10
      }
    ]
  }
}
