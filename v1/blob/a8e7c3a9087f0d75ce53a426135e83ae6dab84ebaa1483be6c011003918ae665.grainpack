{
  "manifest": {
    "activation": [
      "onTransform"
    ],
    "contributes": {
      "settings": [
        {
          "anchor": "snippets.after",
          "key": "actions-card",
          "kind": "panel",
          "label": "",
          "order": 10,
          "searchTerms": [
            "voice actions",
            "trigger",
            "open app",
            "open website",
            "launch"
          ],
          "uiSource": "<!-- Voice Actions — the custom settings card (SPEC §4.1 Level 3). Runs in a\r\n     sandboxed iframe; `window.grain` (injected by the host) is the only channel\r\n     out, and every call is capability-checked in Rust. Stores its rules under\r\n     the extension's own `actions` setting, the shape main.js reads:\r\n       [{ trigger, websites:[{url}], apps:[{path}], enabled }]  -->\r\n<meta charset=\"utf-8\" />\r\n<style>\r\n  /* Grain hands its LIVE palette in as `--grain-*` (the panel bridge reads the\r\n     app's own computed tokens), so this card is drawn with the same surfaces,\r\n     ink and accent as every native row around it, in whichever theme Grain is\r\n     in. It used to carry its own cream-and-gold scheme, which looked like a\r\n     visiting web page sitting in the settings page. The literals are the\r\n     fallback for a card opened outside Grain. */\r\n  :root {\r\n    --paper: var(--grain-paper, #ece5da);\r\n    --sunken: var(--grain-paper-sunken, #ddd5c8);\r\n    --raised: var(--grain-paper-raised, #f2ece1);\r\n    --line: var(--grain-line, rgba(20, 19, 18, 0.08));\r\n    --ink: var(--grain-ink, #141312);\r\n    --soft: var(--grain-ink-soft, #807c76);\r\n    --faint: var(--grain-ink-faint, #a09b94);\r\n    --accent: var(--grain-accent, #ff5d1e);\r\n    --accent-ink: #ffffff;\r\n    --danger: #b4462f;\r\n  }\r\n  /* Standalone fallback only — inside Grain every value above already resolves\r\n     to the host's, and the host rewrites this query to follow Grain's theme\r\n     rather than the OS. */\r\n  @media (prefers-color-scheme: dark) {\r\n    :root {\r\n      --paper: var(--grain-paper, #181716);\r\n      --sunken: var(--grain-paper-sunken, #121110);\r\n      --raised: var(--grain-paper-raised, #211e1b);\r\n      --line: var(--grain-line, rgba(236, 229, 218, 0.08));\r\n      --ink: var(--grain-ink, #ece5da);\r\n      --soft: var(--grain-ink-soft, #9e9587);\r\n      --faint: var(--grain-ink-faint, #6b6358);\r\n    }\r\n  }\r\n  * { box-sizing: border-box; }\r\n  html, body { margin: 0; padding: 0; }\r\n  body {\r\n    font: 13px/1.45 -apple-system, \"Segoe UI\", Inter, system-ui, sans-serif;\r\n    color: var(--ink); background: transparent;\r\n  }\r\n  .card { background: var(--raised); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\r\n  .head { padding: 14px 16px 10px; }\r\n  .title { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }\r\n  .sub { color: var(--soft); font-size: 12px; margin-top: 3px; }\r\n  .body { padding: 4px 16px 16px; display: flex; flex-direction: column; gap: 14px; }\r\n  label.fl { display: block; font-size: 11px; font-weight: 600; letter-spacing: .02em; color: var(--soft); margin-bottom: 6px; }\r\n  input.txt {\r\n    width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px;\r\n    background: var(--sunken); color: var(--ink); font: inherit; outline: none;\r\n  }\r\n  input.txt:focus { border-color: var(--accent); }\r\n  .target { display: flex; align-items: stretch; border: 1px solid var(--line); border-radius: 9px; background: var(--sunken); overflow: hidden; }\r\n  .target:focus-within { border-color: var(--accent); }\r\n  .seg { display: flex; border-right: 1px solid var(--line); }\r\n  .seg button {\r\n    display: flex; align-items: center; gap: 4px; padding: 0 10px; font: inherit; font-size: 12px;\r\n    border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--soft); cursor: pointer;\r\n  }\r\n  .seg button:last-child { border-right: 0; }\r\n  .seg button.on { background: var(--accent); color: var(--accent-ink); font-weight: 600; }\r\n  .target input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: inherit; padding: 8px 10px; outline: none; }\r\n  .tools { display: flex; align-items: center; gap: 2px; padding-right: 4px; }\r\n  .ic { border: 0; background: transparent; color: var(--soft); cursor: pointer; padding: 6px; border-radius: 7px; display: inline-flex; line-height: 0; }\r\n  .ic:hover { color: var(--accent); background: rgba(216,164,60,.12); }\r\n  .ic.count { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 600; width: 28px; justify-content: center; }\r\n  .add { width: 100%; padding: 7px; border: 1px dashed var(--line); border-radius: 9px; background: transparent; color: var(--soft); font: inherit; font-size: 12px; cursor: pointer; }\r\n  .add:hover { color: var(--ink); border-color: var(--accent); }\r\n  .row-actions { display: flex; justify-content: flex-end; gap: 8px; }\r\n  .btn { padding: 7px 13px; border-radius: 9px; border: 1px solid var(--line); background: var(--sunken); color: var(--ink); font: inherit; font-weight: 500; cursor: pointer; }\r\n  .btn:hover { border-color: var(--faint); }\r\n  .btn[disabled] { opacity: .5; cursor: not-allowed; }\r\n  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }\r\n  .list { border-top: 1px solid var(--line); }\r\n  .empty { padding: 22px 16px; text-align: center; color: var(--faint); font-size: 12px; }\r\n  .item { display: flex; align-items: center; gap: 10px; padding: 9px 16px; border-top: 1px solid var(--line); }\r\n  .item:first-child { border-top: 0; }\r\n  .item.off { opacity: .5; }\r\n  .chip { background: var(--sunken); border: 1px solid var(--line); border-radius: 7px; padding: 2px 8px; font-size: 12px; font-weight: 600; white-space: nowrap; }\r\n  .arrow { color: var(--faint); }\r\n  .tgts { display: flex; gap: 6px; min-width: 0; overflow: hidden; flex: 1; }\r\n  .tgt { display: inline-flex; align-items: center; gap: 4px; max-width: 190px; font-size: 11.5px; color: var(--soft); background: var(--sunken); border: 1px solid var(--line); border-radius: 6px; padding: 2px 7px; }\r\n  .tgt span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n  .sw { width: 32px; height: 18px; border-radius: 999px; background: #0a0a0a; border: 0; position: relative; cursor: pointer; flex: none; }\r\n  .sw::after { content: \"\"; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #f0ebe3; transition: transform .18s; }\r\n  .sw.on { background: var(--accent); }\r\n  .sw.on::after { transform: translateX(14px); }\r\n  .err { margin: 0 16px; padding: 7px 10px; border-radius: 8px; background: rgba(180,70,47,.12); color: var(--danger); font-size: 12px; }\r\n  svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\r\n</style>\r\n\r\n<div class=\"card\">\r\n  <div class=\"head\">\r\n    <div class=\"title\">Actions</div>\r\n    <div class=\"sub\">Say a phrase to open apps and websites — one action can open several at once. Fully local; the trigger is removed from what gets typed.</div>\r\n  </div>\r\n  <div id=\"err\" class=\"err\" style=\"display:none\"></div>\r\n  <div class=\"body\">\r\n    <div>\r\n      <label class=\"fl\" for=\"trigger\">Trigger phrase</label>\r\n      <input id=\"trigger\" class=\"txt\" type=\"text\" maxlength=\"100\" placeholder=\"e.g. start coding, open email\" />\r\n    </div>\r\n    <div>\r\n      <label class=\"fl\">Opens</label>\r\n      <div id=\"targets\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\r\n      <button class=\"add\" id=\"add-target\" style=\"margin-top:8px\">+ Add target</button>\r\n    </div>\r\n    <div class=\"row-actions\">\r\n      <button class=\"btn\" id=\"test\">▶ Test</button>\r\n      <button class=\"btn\" id=\"cancel\" style=\"display:none\">Cancel</button>\r\n      <button class=\"btn primary\" id=\"submit\">Add action</button>\r\n    </div>\r\n  </div>\r\n  <div id=\"list\" class=\"list\"></div>\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  var g = window.grain;\r\n  var ICON = {\r\n    app: '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>',\r\n    web: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18\"/></svg>',\r\n    cross: '<svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>',\r\n    folder: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>',\r\n    crosshair: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg>',\r\n    play: '<svg viewBox=\"0 0 24 24\"><path d=\"M7 4l13 8-13 8z\"/></svg>',\r\n    pencil: '<svg viewBox=\"0 0 24 24\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2 2 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg>',\r\n    trash: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"/></svg>'\r\n  };\r\n  var state = { editing: null, trigger: \"\", targets: [{ kind: \"app\", value: \"\" }], actions: [], capturing: null };\r\n  var $ = function (id) { return document.getElementById(id); };\r\n\r\n  function showErr(msg) { var e = $(\"err\"); if (!msg) { e.style.display = \"none\"; return; } e.textContent = msg; e.style.display = \"block\"; }\r\n\r\n  // Storage shape (what main.js reads): { trigger, websites:[{url}], apps:[{path}], enabled }.\r\n  function toStored(trigger, targets, enabled) {\r\n    var websites = [], apps = [];\r\n    targets.forEach(function (t) {\r\n      var v = (t.value || \"\").trim(); if (!v) return;\r\n      if (t.kind === \"url\") websites.push({ url: v }); else apps.push({ path: v });\r\n    });\r\n    return { trigger: trigger, websites: websites, apps: apps, enabled: enabled !== false };\r\n  }\r\n  function toTargets(a) {\r\n    var out = [];\r\n    (a.apps || []).forEach(function (p) { if (p && p.path) out.push({ kind: \"app\", value: p.path }); });\r\n    (a.websites || []).forEach(function (w) { if (w && w.url) out.push({ kind: \"url\", value: w.url }); });\r\n    return out.length ? out : [{ kind: \"app\", value: \"\" }];\r\n  }\r\n  function chips(a) { return toTargets(a).filter(function (t) { return t.value; }); }\r\n\r\n  function load() {\r\n    g.settings.get(\"actions\").then(function (v) {\r\n      state.actions = Array.isArray(v) ? v : [];\r\n      renderList();\r\n    }).catch(function (e) { showErr(String(e && e.message || e)); });\r\n  }\r\n  function persist(next) {\r\n    state.actions = next;\r\n    renderList();\r\n    g.settings.set(\"actions\", next).catch(function (e) { showErr(String(e && e.message || e)); load(); });\r\n  }\r\n\r\n  function renderTargets() {\r\n    var box = $(\"targets\"); box.innerHTML = \"\";\r\n    state.targets.forEach(function (t, i) {\r\n      var row = document.createElement(\"div\"); row.className = \"target\";\r\n      var cap = state.capturing && state.capturing.i === i;\r\n      row.innerHTML =\r\n        '<div class=\"seg\">' +\r\n          '<button data-k=\"app\" class=\"' + (t.kind === \"app\" ? \"on\" : \"\") + '\">' + ICON.app + ' App</button>' +\r\n          '<button data-k=\"url\" class=\"' + (t.kind === \"url\" ? \"on\" : \"\") + '\">' + ICON.web + ' Web</button>' +\r\n        '</div>' +\r\n        '<input type=\"text\" value=\"' + esc(t.value) + '\" placeholder=\"' + (t.kind === \"app\" ? \"App path, e.g. C:\\\\\\\\…\\\\\\\\Code.exe\" : \"Website, e.g. github.com\") + '\" />' +\r\n        '<div class=\"tools\">' +\r\n          (cap ? '<span class=\"ic count\">' + state.capturing.n + '</span>'\r\n               : '<button class=\"ic\" data-a=\"capture\" title=\"Capture focused app\">' + ICON.crosshair + '</button>') +\r\n          (t.kind === \"app\" ? '<button class=\"ic\" data-a=\"browse\" title=\"Browse for an app\">' + ICON.folder + '</button>' : '') +\r\n          '<button class=\"ic\" data-a=\"remove\" title=\"Remove\">' + ICON.cross + '</button>' +\r\n        '</div>';\r\n      row.querySelectorAll(\".seg button\").forEach(function (b) {\r\n        b.onclick = function () { state.targets[i].kind = b.getAttribute(\"data-k\"); renderTargets(); };\r\n      });\r\n      row.querySelector(\"input\").oninput = function (e) { state.targets[i].value = e.target.value; };\r\n      row.querySelectorAll(\"[data-a]\").forEach(function (b) {\r\n        var a = b.getAttribute(\"data-a\");\r\n        b.onclick = function () {\r\n          if (a === \"remove\") { state.targets.splice(i, 1); if (!state.targets.length) state.targets.push({ kind: \"app\", value: \"\" }); renderTargets(); }\r\n          else if (a === \"browse\") browse(i);\r\n          else if (a === \"capture\") capture(i);\r\n        };\r\n      });\r\n      box.appendChild(row);\r\n    });\r\n  }\r\n\r\n  function browse(i) {\r\n    g.open.pickApp().then(function (p) { if (p) { state.targets[i].value = p; renderTargets(); } })\r\n      .catch(function (e) { showErr(String(e && e.message || e)); });\r\n  }\r\n  function capture(i) {\r\n    if (state.capturing) return;\r\n    var n = 3; state.capturing = { i: i, n: n }; renderTargets();\r\n    var tick = setInterval(function () {\r\n      n -= 1;\r\n      if (n > 0) { state.capturing = { i: i, n: n }; renderTargets(); return; }\r\n      clearInterval(tick); state.capturing = null;\r\n      g.focusedApp().then(function (app) {\r\n        if (!app) { showErr(\"Couldn't detect the focused app. Try again.\"); renderTargets(); return; }\r\n        if (app.urlHost) state.targets[i] = { kind: \"url\", value: app.urlHost };\r\n        else if (app.exePath) state.targets[i] = { kind: \"app\", value: app.exePath };\r\n        else showErr(\"Couldn't resolve a launchable path for \" + (app.name || app.exe || \"that app\") + \".\");\r\n        renderTargets();\r\n      }).catch(function (e) { showErr(String(e && e.message || e)); renderTargets(); });\r\n    }, 1000);\r\n  }\r\n\r\n  function test() {\r\n    showErr(\"\");\r\n    state.targets.forEach(function (t) {\r\n      var v = (t.value || \"\").trim(); if (!v) return;\r\n      if (t.kind === \"url\") g.open.url(v); else g.open.app(v);\r\n    });\r\n  }\r\n\r\n  function submit() {\r\n    showErr(\"\");\r\n    var trig = $(\"trigger\").value.trim();\r\n    if (!trig) { showErr(\"Enter a trigger phrase.\"); return; }\r\n    var hasTarget = state.targets.some(function (t) { return (t.value || \"\").trim(); });\r\n    if (!hasTarget) { showErr(\"Add at least one app or website.\"); return; }\r\n    var norm = trig.toLowerCase().replace(/[^a-z0-9]/g, \"\");\r\n    var clash = state.actions.some(function (a, idx) {\r\n      return idx !== state.editing && (a.trigger || \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\") === norm;\r\n    });\r\n    if (clash) { showErr('\"' + trig + '\" already uses that trigger.'); return; }\r\n    var enabled = state.editing != null ? (state.actions[state.editing].enabled !== false) : true;\r\n    var stored = toStored(trig, state.targets, enabled);\r\n    var next = state.actions.slice();\r\n    if (state.editing != null) next[state.editing] = stored; else next.push(stored);\r\n    resetForm();\r\n    persist(next);\r\n  }\r\n  function resetForm() {\r\n    state.editing = null; state.trigger = \"\"; state.targets = [{ kind: \"app\", value: \"\" }];\r\n    $(\"trigger\").value = \"\"; $(\"cancel\").style.display = \"none\"; $(\"submit\").textContent = \"Add action\";\r\n    renderTargets();\r\n  }\r\n  function edit(i) {\r\n    var a = state.actions[i];\r\n    state.editing = i; state.targets = toTargets(a);\r\n    $(\"trigger\").value = a.trigger || \"\"; $(\"cancel\").style.display = \"\";\r\n    $(\"submit\").textContent = \"Update action\"; renderTargets();\r\n    showErr(\"\");\r\n  }\r\n\r\n  function renderList() {\r\n    var box = $(\"list\");\r\n    if (!state.actions.length) { box.innerHTML = '<div class=\"empty\">No actions yet. Add one above to open apps or sites with your voice.</div>'; return; }\r\n    box.innerHTML = \"\";\r\n    state.actions.forEach(function (a, i) {\r\n      var on = a.enabled !== false;\r\n      var item = document.createElement(\"div\"); item.className = \"item\" + (on ? \"\" : \" off\");\r\n      var tg = chips(a).map(function (t) {\r\n        return '<span class=\"tgt\">' + (t.kind === \"app\" ? ICON.app : ICON.web) + '<span>' + esc(t.value) + '</span></span>';\r\n      }).join(\"\");\r\n      item.innerHTML =\r\n        '<span class=\"chip\">' + esc(a.trigger || \"\") + '</span>' +\r\n        '<span class=\"arrow\">→</span>' +\r\n        '<div class=\"tgts\">' + tg + '</div>' +\r\n        '<button class=\"ic\" data-a=\"run\" title=\"Run now\">' + ICON.play + '</button>' +\r\n        '<button class=\"sw ' + (on ? \"on\" : \"\") + '\" data-a=\"toggle\" title=\"Enable / disable\"></button>' +\r\n        '<button class=\"ic\" data-a=\"edit\" title=\"Edit\">' + ICON.pencil + '</button>' +\r\n        '<button class=\"ic\" data-a=\"del\" title=\"Delete\">' + ICON.trash + '</button>';\r\n      item.querySelectorAll(\"[data-a]\").forEach(function (b) {\r\n        var act = b.getAttribute(\"data-a\");\r\n        b.onclick = function () {\r\n          if (act === \"run\") { chips(a).forEach(function (t) { if (t.kind === \"url\") g.open.url(t.value); else g.open.app(t.value); }); }\r\n          else if (act === \"toggle\") { var n = state.actions.slice(); n[i] = Object.assign({}, a, { enabled: !on }); persist(n); }\r\n          else if (act === \"edit\") edit(i);\r\n          else if (act === \"del\") { if (state.editing === i) resetForm(); var n = state.actions.slice(); n.splice(i, 1); persist(n); }\r\n        };\r\n      });\r\n      box.appendChild(item);\r\n    });\r\n  }\r\n\r\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) { return ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c]; }); }\r\n\r\n  $(\"add-target\").onclick = function () { state.targets.push({ kind: \"app\", value: \"\" }); renderTargets(); };\r\n  $(\"test\").onclick = test;\r\n  $(\"submit\").onclick = submit;\r\n  $(\"cancel\").onclick = resetForm;\r\n\r\n  renderTargets();\r\n  load();\r\n})();\r\n</script>\r\n"
        }
      ]
    },
    "description": "Say a trigger phrase to open your apps and sites, and Grain strips it from what gets typed.",
    "entry_source": "// Voice Actions — the worker. Runs on the finalized transcript: matches the\r\n// user's configured triggers, opens their websites/apps, and returns the text\r\n// with the trigger removed.\r\n//\r\n// Config lives in the extension's declared settings (rendered natively in the\r\n// Snippets tab — no webview): `actions` is a list of\r\n//   { trigger, websites: [{ url }], apps: [{ path }] }.\r\n//\r\n// Security: this worker never launches anything on its own. `grain.open.url` is\r\n// scheme-allowlisted by the host; `grain.open.app` only launches an app the user\r\n// picked via the app-path control (which records approval). It merely relays the\r\n// user's configured rules.\r\n\r\nfunction normalize(s) {\r\n  return String(s || \"\").toLowerCase().trim();\r\n}\r\n\r\ngrain.onTransform(function (text) {\r\n  return grain.settings.get(\"actions\").then(function (actions) {\r\n    actions = Array.isArray(actions) ? actions : [];\r\n    if (!actions.length) return text;\r\n\r\n    var out = text;\r\n    var fired = [];\r\n    actions.forEach(function (a) {\r\n      if (!a || a.enabled === false) return;\r\n      var trigger = normalize(a.trigger);\r\n      if (!trigger) return;\r\n      var idx = out.toLowerCase().indexOf(trigger);\r\n      if (idx !== -1) {\r\n        out = out.slice(0, idx) + out.slice(idx + trigger.length);\r\n        fired.push(a);\r\n      }\r\n    });\r\n\r\n    // Fire-and-forget so a slow launch never blocks the paste path.\r\n    fired.forEach(function (a) {\r\n      (a.websites || []).forEach(function (w) {\r\n        if (w && w.url) {\r\n          try { grain.open.url(String(w.url)); } catch (e) {}\r\n        }\r\n      });\r\n      (a.apps || []).forEach(function (p) {\r\n        if (p && p.path) {\r\n          try { grain.open.app(String(p.path)); } catch (e) {}\r\n        }\r\n      });\r\n    });\r\n\r\n    return out.replace(/\\s+/g, \" \").trim();\r\n  });\r\n});\r\n",
    "grainApi": "^1.0",
    "id": "grain.voice-actions",
    "name": "Voice Actions",
    "permissions": [
      "transform:transcript",
      "open:url",
      "open:app",
      "capture:app",
      "settings"
    ],
    "repository": "https://github.com/Punit-Dethe/Grain-Extention",
    "tier": "scripted",
    "version": "1.0.1"
  },
  "payloads": {}
}
