{
  "manifest": {
    "contributes": {
      "settings": [
        {
          "key": "grain-space",
          "kind": "panel",
          "label": "",
          "order": 10,
          "searchTerms": [
            "notes",
            "grain space",
            "note",
            "vault",
            "obsidian",
            "recall",
            "memory",
            "second brain",
            "reminders",
            "quick add",
            "semantic search",
            "embeddings"
          ],
          "uiSource": "grain://grain-space/settings"
        }
      ]
    },
    "description": "A local scratch space for spoken and captured notes. Speak or select anything and it is saved as plain Markdown with an AI title, summary and reminders; ask a question out loud and Grain answers from your own notes. Works against its own store or an Obsidian vault you already sync. Zero resident memory while its surfaces are closed.",
    "grainApi": "^1.0",
    "id": "grain.grain-space",
    "name": "Grain Space",
    "permissions": [
      "capture:selection",
      "storage",
      "settings",
      "llm",
      "embed"
    ],
    "repository": "https://github.com/Punit-Dethe/Grain",
    "tier": "builtin",
    "version": "1.0.0"
  },
  "payloads": {}
}
