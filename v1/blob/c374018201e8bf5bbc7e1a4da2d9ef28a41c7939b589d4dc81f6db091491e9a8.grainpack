{
  "manifest": {
    "activation": [
      "onShortcut:open"
    ],
    "contributes": {
      "shortcuts": [
        {
          "id": "open",
          "label": "Open the note window"
        }
      ]
    },
    "description": "A window for reading and editing your Grain Space notes.",
    "entry_source": "// Note Window — the worker. Its only job is to open the window when the\n// shortcut fires; everything a person does happens inside the surface, which\n// talks to the host on its own channel with its own token.\n//\n// Deliberately this small. The worker is asleep until the shortcut wakes it,\n// does one thing, and is reaped — nothing here is resident. The window it opens\n// is the host's: built hidden once, slept on close, destroyed when idle.\n\ngrain.onShortcut(function (id) {\n  if (id !== \"open\") return;\n  return grain.workspace.open().catch(function (e) {\n    grain.log.warn(\"note-ui: couldn't open the window: \" + ((e && e.message) || e));\n  });\n});\n",
    "grainApi": "^1.0",
    "id": "grain.note-ui",
    "name": "Note Window",
    "permissions": [
      "notes",
      "surface:workspace"
    ],
    "repository": "https://github.com/Punit-Dethe/Grain",
    "surfaces": {
      "workspace": {
        "minSize": [
          900,
          600
        ],
        "title": "Notes",
        "uiSource": "<!--\n  Note Window — P2 skeleton (NOTE-UI-EXTENSION-PLAN.md).\n\n  Deliberately small. Its job is to prove the whole path end to end — install,\n  grant, shortcut, window, data — with fifty lines rather than five thousand, so\n  that when the real UI moves in at P4 the only new thing is the UI itself.\n\n  It also measures the round trip, because that is the open question the plan\n  names: a note editor must not turn keystrokes into host calls, and the number\n  on screen is what tells us how much headroom there is.\n-->\n<style>\n  :root {\n    /* Grain injects its live palette; the literals are the standalone fallback. */\n    --paper: var(--grain-paper, #ece5da);\n    --raised: var(--grain-paper-raised, #f2ece1);\n    --sunken: var(--grain-paper-sunken, #ddd5c8);\n    --line: var(--grain-line, rgba(20, 19, 18, 0.08));\n    --ink: var(--grain-ink, #141312);\n    --soft: var(--grain-ink-soft, #807c76);\n    --faint: var(--grain-ink-faint, #a09b94);\n    --accent: var(--grain-accent, #ff5d1e);\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    padding: 24px;\n    background: var(--paper);\n    color: var(--ink);\n    font: 14px/1.55 ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  }\n  h1 { margin: 0 0 4px; font-size: 1.15rem; letter-spacing: -0.01em; }\n  .meta { color: var(--faint); font-size: 12px; margin-bottom: 18px; }\n  ul { list-style: none; margin: 0; padding: 0; }\n  li {\n    padding: 10px 12px;\n    border: 1px solid var(--line);\n    border-radius: 10px;\n    background: var(--raised);\n    margin-bottom: 6px;\n  }\n  .title { font-weight: 500; }\n  .tldr { color: var(--soft); font-size: 12px; margin-top: 2px; }\n  .empty, .error { color: var(--soft); }\n  .error { color: #b4462f; }\n</style>\n\n<h1>Notes</h1>\n<div class=\"meta\" id=\"meta\">Loading…</div>\n<ul id=\"list\"></ul>\n\n<script>\n  (function () {\n    var listEl = document.getElementById(\"list\");\n    var metaEl = document.getElementById(\"meta\");\n\n    function esc(s) {\n      return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) {\n        return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c];\n      });\n    }\n\n    var started = performance.now();\n    grain.notes\n      .cards()\n      .then(function (cards) {\n        // The measurement the plan asks for: one host call, wall-clock, on the\n        // real channel rather than a guess about it.\n        var ms = Math.round(performance.now() - started);\n        cards = Array.isArray(cards) ? cards : [];\n        metaEl.textContent =\n          cards.length + (cards.length === 1 ? \" note\" : \" notes\") +\n          \" · loaded in \" + ms + \"ms\";\n        if (!cards.length) {\n          listEl.innerHTML =\n            '<li class=\"empty\">Nothing saved yet. Capture a note in Grain and it appears here.</li>';\n          return;\n        }\n        listEl.innerHTML = cards\n          .map(function (c) {\n            return (\n              '<li><div class=\"title\">' + esc(c.title || \"Untitled\") + \"</div>\" +\n              (c.tldr ? '<div class=\"tldr\">' + esc(c.tldr) + \"</div>\" : \"\") +\n              \"</li>\"\n            );\n          })\n          .join(\"\");\n      })\n      .catch(function (e) {\n        metaEl.textContent = \"\";\n        listEl.innerHTML =\n          '<li class=\"error\">' + esc((e && e.message) || e) + \"</li>\";\n      });\n  })();\n</script>\n"
      }
    },
    "tier": "scripted",
    "version": "0.1.0"
  },
  "payloads": {}
}
