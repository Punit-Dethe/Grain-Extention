eight:600;cursor:pointer;border:1px solid transparent;transition:filter .14s ease,background .14s ease}.gs-chat-forget-btn{background:#e5484d;color:#fff}.gs-chat-forget-btn:hover{filter:brightness(1.05)}.gs-chat-keep-btn{background:none;border-color:var(--line);color:var(--muted)}.gs-chat-keep-btn:hover{color:var(--ink);border-color:var(--sel-border)}.gs-chat-forget-done{font-size:11.5px;color:var(--muted)}.gs-chat-error{font-size:12px;color:#e5484d;padding:2px 2px 6px}.gs-chat-typing{display:inline-flex;align-items:center;gap:4px;padding:4px 0}.gs-chat-typing span{width:5px;height:5px;border-radius:50%;background:var(--ghost);animation:gs-chat-blink 1.2s infinite ease-in-out both}.gs-chat-typing span:nth-child(2){animation-delay:.15s}.gs-chat-typing span:nth-child(3){animation-delay:.3s}@keyframes gs-chat-blink{0%,80%,to{opacity:.25}40%{opacity:1}}.gs-fmt{flex:0 1 auto;display:flex;align-items:center;gap:1px;min-width:0;overflow:hidden}.gs-fmt-btn{flex:none;display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border:none;background:transparent;border-radius:var(--gs-r-sm);color:var(--muted);cursor:pointer;padding:0;transition:background .12s ease,color .12s ease}.gs-fmt-btn:hover{background:var(--hover);color:var(--ink)}.gs-fmt-btn:active{background:var(--line)}.gs-fmt-sep{flex:none;width:1px;height:16px;margin:0 var(--gs-sp-1);background:var(--line)}.gs-cm-check{-moz-appearance:none;appearance:none;-webkit-appearance:none;width:15px;height:15px;margin:0 2px 0 0;border:1.5px solid var(--ghost);border-radius:5px;background:var(--sheet);vertical-align:-2px;cursor:pointer;position:relative;transition:background .12s ease,border-color .12s ease}.gs-cm-check:hover{border-color:var(--ghost)}.gs-cm-check:checked{background:var(--ghost);border-color:var(--ghost)}.gs-cm-check:checked:after{content:\"\";position:absolute;left:4px;top:1px;width:4px;height:8px;border:solid #fff;border-width:0 2px 2px 0;transform:rotate(45deg)}.gs-edit .cm-line.g