: var(--green);--callout-soft: var(--green-soft)}.gs-cm-callout--warning,.gs-cm-callout--caution,.gs-cm-callout--attention{--callout: var(--amber);--callout-soft: var(--amber-soft)}.gs-cm-callout--danger,.gs-cm-callout--error,.gs-cm-callout--bug,.gs-cm-callout--failure,.gs-cm-callout--fail{--callout: var(--error);--callout-soft: rgba(192, 57, 47, .09)}.gs-cm-callout--quote,.gs-cm-callout--cite,.gs-cm-callout--example,.gs-cm-callout--abstract,.gs-cm-callout--summary{--callout: var(--purple);--callout-soft: var(--purple-soft)}.gs-dock{flex:none;border-top:1px solid var(--line);padding:10px 14px 12px}.gs-dock-head{display:flex;align-items:center;justify-content:space-between;padding:0 4px;margin-bottom:6px}.gs-dock-title{font-size:var(--gs-fs-11);font-weight:var(--gs-w-semi);letter-spacing:.4px;text-transform:uppercase;color:var(--muted)}.gs-dock-toggle{border:none;background:none;font-size:var(--gs-fs-11);font-weight:var(--gs-w-medium);color:var(--faint);cursor:pointer;padding:2px 6px;border-radius:5px}.gs-dock-toggle:hover{color:var(--ink-2);background:var(--hover)}.gs-dock-list{display:flex;flex-direction:column;gap:1px}.gs-dock-list--exp{max-height:204px;overflow-y:auto;scrollbar-gutter:stable}.gs-dock-list--exp::-webkit-scrollbar{width:6px}.gs-dock-list--exp::-webkit-scrollbar-thumb{background:var(--scroll-thumb);border-radius:3px;border:2px solid transparent;background-clip:padding-box}.gs-dock-item{display:flex;align-items:center;gap:9px;width:100%;padding:7px 8px;border:none;background:none;border-radius:var(--gs-r-sm);cursor:pointer;text-align:left;transition:background .12s ease}.gs-dock-item:hover{background:var(--hover)}.gs-dock-dot{flex:none;width:6px;height:6px;border-radius:50%;background:var(--ink-2)}.gs-dock-dot--past{background:var(--ghost)}.gs-dock-item-title{flex:1 1 auto;min-width:0;font-size:var(--gs-fs-12);font-weight:var(--gs-w-medium);color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gs-dock-item-when{flex:none;font-size:10px;font-weight:var(--gs-w-medium);color:var(--faint);font-variant-numeric:tabular-nums}.gs-cal-view{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;background:var(--calendar-sheet);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow-lg),inset 0 1px 0 var(--inset-highlight);overflow:hidden}.gs-cal-view-head{flex:none;display:flex;align-items:center;justify-content:space-between;padding:22px 28px 16px}.gs-cal-view-title{font-size:20px;font-weight:var(--gs-w-bold);letter-spacing:-.01em;color:var(--ink)}.gs-cal-nav{display:flex;align-items:center;gap:5px}.gs-cal-nav button{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border:1px solid var(--line);background:var(--paper);border-radius:8px;color:var(--ink-2);cursor:pointer;transition:background .12s ease,border-color .12s ease}.gs-cal-nav button:hover{background:var(--hover);border-color:var(--ghost)}.gs-cal-today-btn{width:auto!important;padding:0 12px!important;font-family:var(--body);font-size:var(--gs-fs-12);font-weight:var(--gs-w-medium)}.gs-cal-month{flex:none;padding:0 28px 12px}.gs-cal-dow-row{display:grid;grid-template-columns:repeat(7,1fr)}.gs-cal-dow-cell{text-align:center;font-size:var(--gs-fs-11);font-weight:var(--gs-w-semi);letter-spacing:.4px;text-transform:uppercase;color:var(--faint);padding:4px 0 10px}.gs-cal-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}.gs-cal-cell{position:relative;min-height:46px;display:flex;align-items:flex-start;justify-content:flex-end;padding:6px;border:1px solid transparent;border-radius:10px;background:none;cursor:pointer;font-family:var(--body);font-size:var(--gs-fs-13);font-weight:var(--gs-w-medium);color:var(--ink-2);transition:background .12s ease,border-color .12s ease}.gs-cal-cell:hover{background:var(--hover)}.gs-cal-cell--empty,.gs-cal-cell--empty:hover{cursor:default;background:none}.gs-cal-cell--sel{border-color:var(--ghost);background:var(--hover)}.gs-cal-num{display:inline-flex;align-items:center;justify-content:center;min-width:26px;height:26px;border-radius:50%}.gs-cal-cell--today{color:var(--ink);font-weight:var(--gs-w-bold)}.gs-cal-cell--today .gs-cal-num{background:var(--ink);color:#fff}.gs-cal-dots{position:absolute;left:8px;bottom:7px;display:flex;gap:3px}.gs-cal-dots span{width:5px;height:5px;border-radius:50%;background:var(--muted)}.gs-cal-list{flex:1 1 auto;min-height:0;overflow-y:auto;border-top:1px solid var(--line);padding:16px 28px 24px}.gs-cal-list-head{font-size:var(--gs-fs-11);font-weight:var(--gs-w-semi);letter-spacing:.4px;text-transform:uppercase;color:var(--muted);margin-bottom:12px}.gs-cal-empty{padding:28px 0;text-align:center;font-size:var(--gs-fs-13);color:var(--faint)}.gs-cal-ev{display:flex;align-items:center;gap:14px;width:100%;padding:11px 14px;border:1px solid var(--line);border-radius:var(--gs-r-md);background:var(--paper);cursor:pointer;text-align:left;margin-bottom:6px;transition:border-color .12s ease,box-shadow .12s ease}.gs-cal-ev:hover{border-color:var(--ghost);box-shadow:var(--shadow-sm)}.gs-cal-ev--past{opacity:.6}.gs-cal-ev-time{flex:none;display:flex;flex-direction:column;width:62px}.gs-cal-ev-day{font-size:var(--gs-fs-12);font-weight:var(--gs-w-semi);color:var(--ink);font-variant-numeric:tabular-nums}.gs-cal-ev-clock{font-size:var(--gs-fs-11);color:var(--muted);font-variant-numeric:tabular-nums;margin-top:1px}.gs-cal-ev-body{flex:1 1 auto;min-width:0;display:flex;flex-direction:column}.gs-cal-ev-title{font-size:var(--gs-fs-13);font-weight:var(--gs-w-semi);color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.gs-cal-ev-sub{font-size:var(--gs-fs-12);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}.gs-cal-ev-icon{flex:none;color:var(--faint)}</style>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
