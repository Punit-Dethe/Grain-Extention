{
  "manifest": {
    "activation": [
      "onTransform"
    ],
    "contributes": {
      "settings": [
        {
          "anchor": "snippets.after",
          "key": "actions-card",
          "kind": "panel",
          "label": "",
          "order": 10,
          "searchTerms": [
            "voice actions",
            "trigger",
            "open app",
            "open website",
            "launch"
          ],
          "uiSource": "<!-- Voice Actions — the custom settings card (SPEC §4.1 Level 3). Runs in a\n     sandboxed iframe; `window.grain` (injected by the host) is the only channel\n     out, and every call is capability-checked in Rust. Stores its rules under\n     the extension's own `actions` setting, the shape main.js reads:\n       [{ trigger, websites:[{url}], apps:[{path}], enabled }]  -->\n<meta charset=\"utf-8\" />\n<style>\n  :root {\n    --paper: #faf8f3; --sunken: #efeae1; --raised: #ffffff;\n    --line: #e5dfd2; --ink: #17150f; --soft: #5b564c; --faint: #938d80;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #b4462f;\n  }\n  /* The host (Grain) tells us its theme via data-grain-theme, because a\n     sandboxed iframe's prefers-color-scheme reports the OPERATING SYSTEM — which\n     is the wrong answer whenever the OS and Grain's own theme disagree. The\n     media query stays as the fallback for a card opened outside Grain. */\n  @media (prefers-color-scheme: dark) {\n    :root {\n    --paper: #16140f; --sunken: #1e1b15; --raised: #201d16;\n    --line: #322d23; --ink: #f3efe6; --soft: #b7b0a2; --faint: #7d7668;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #e0765c;\n    }\n  }\n  :root[data-grain-theme=\"dark\"] {\n    --paper: #16140f; --sunken: #1e1b15; --raised: #201d16;\n    --line: #322d23; --ink: #f3efe6; --soft: #b7b0a2; --faint: #7d7668;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #e0765c;\n  }\n  :root[data-grain-theme=\"light\"] {\n    --paper: #faf8f3; --sunken: #efeae1; --raised: #ffffff;\n    --line: #e5dfd2; --ink: #17150f; --soft: #5b564c; --faint: #938d80;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #b4462f;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    font: 13px/1.45 -apple-system, \"Segoe UI\", Inter, system-ui, sans-serif;\n    color: var(--ink); background: transparent;\n  }\n  .card { background: var(--raised); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\n  .head { padding: 14px 16px 10px; }\n  .title { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; }\n  .sub { color: var(--soft); font-size: 12px; margin-top: 3px; }\n  .body { padding: 4px 16px 16px; display: flex; flex-direction: column; gap: 14px; }\n  label.fl { display: block; font-size: 11px; font-weight: 600; letter-spacing: .02em; color: var(--soft); margin-bottom: 6px; }\n  input.txt {\n    width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px;\n    background: var(--sunken); color: var(--ink); font: inherit; outline: none;\n  }\n  input.txt:focus { border-color: var(--accent); }\n  .target { display: flex; align-items: stretch; border: 1px solid var(--line); border-radius: 9px; background: var(--sunken); overflow: hidden; }\n  .target:focus-within { border-color: var(--accent); }\n  .seg { display: flex; border-right: 1px solid var(--line); }\n  .seg button {\n    display: flex; align-items: center; gap: 4px; padding: 0 10px; font: inherit; font-size: 12px;\n    border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--soft); cursor: pointer;\n  }\n  .seg button:last-child { border-right: 0; }\n  .seg button.on { background: var(--accent); color: var(--accent-ink); font-weight: 600; }\n  .target input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ink); font: inherit; padding: 8px 10px; outline: none; }\n  .tools { display: flex; align-items: center; gap: 2px; padding-right: 4px; }\n  .ic { border: 0; background: transparent; color: var(--soft); cursor: pointer; padding: 6px; border-radius: 7px; display: inline-flex; line-height: 0; }\n  .ic:hover { color: var(--accent); background: rgba(216,164,60,.12); }\n  .ic.count { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 600; width: 28px; justify-content: center; }\n  .add { width: 100%; padding: 7px; border: 1px dashed var(--line); border-radius: 9px; background: transparent; color: var(--soft); font: inherit; font-size: 12px; cursor: pointer; }\n  .add:hover { color: var(--ink); border-color: var(--accent); }\n  .row-actions { display: flex; justify-content: flex-end; gap: 8px; }\n  .btn { padding: 7px 13px; border-radius: 9px; border: 1px solid var(--line); background: var(--sunken); color: var(--ink); font: inherit; font-weight: 500; cursor: pointer; }\n  .btn:hover { border-color: var(--faint); }\n  .btn[disabled] { opacity: .5; cursor: not-allowed; }\n  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }\n  .list { border-top: 1px solid var(--line); }\n  .empty { padding: 22px 16px; text-align: center; color: var(--faint); font-size: 12px; }\n  .item { display: flex; align-items: center; gap: 10px; padding: 9px 16px; border-top: 1px solid var(--line); }\n  .item:first-child { border-top: 0; }\n  .item.off { opacity: .5; }\n  .chip { background: var(--sunken); border: 1px solid var(--line); border-radius: 7px; padding: 2px 8px; font-size: 12px; font-weight: 600; white-space: nowrap; }\n  .arrow { color: var(--faint); }\n  .tgts { display: flex; gap: 6px; min-width: 0; overflow: hidden; flex: 1; }\n  .tgt { display: inline-flex; align-items: center; gap: 4px; max-width: 190px; font-size: 11.5px; color: var(--soft); background: var(--sunken); border: 1px solid var(--line); border-radius: 6px; padding: 2px 7px; }\n  .tgt span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .sw { width: 32px; height: 18px; border-radius: 999px; background: #0a0a0a; border: 0; position: relative; cursor: pointer; flex: none; }\n  .sw::after { content: \"\"; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #f0ebe3; transition: transform .18s; }\n  .sw.on { background: var(--accent); }\n  .sw.on::after { transform: translateX(14px); }\n  .err { margin: 0 16px; padding: 7px 10px; border-radius: 8px; background: rgba(180,70,47,.12); color: var(--danger); font-size: 12px; }\n  svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n</style>\n\n<div class=\"card\">\n  <div class=\"head\">\n    <div class=\"title\">Actions</div>\n    <div class=\"sub\">Say a phrase to open apps and websites — one action can open several at once. Fully local; the trigger is removed from what gets typed.</div>\n  </div>\n  <div id=\"err\" class=\"err\" style=\"display:none\"></div>\n  <div class=\"body\">\n    <div>\n      <label class=\"fl\" for=\"trigger\">Trigger phrase</label>\n      <input id=\"trigger\" class=\"txt\" type=\"text\" maxlength=\"100\" placeholder=\"e.g. start coding, open email\" />\n    </div>\n    <div>\n      <label class=\"fl\">Opens</label>\n      <div id=\"targets\" style=\"display:flex;flex-direction:column;gap:8px\"></div>\n      <button class=\"add\" id=\"add-target\" style=\"margin-top:8px\">+ Add target</button>\n    </div>\n    <div class=\"row-actions\">\n      <button class=\"btn\" id=\"test\">▶ Test</button>\n      <button class=\"btn\" id=\"cancel\" style=\"display:none\">Cancel</button>\n      <button class=\"btn primary\" id=\"submit\">Add action</button>\n    </div>\n  </div>\n  <div id=\"list\" class=\"list\"></div>\n</div>\n\n<script>\n(function () {\n  var g = window.grain;\n  var ICON = {\n    app: '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>',\n    web: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18\"/></svg>',\n    cross: '<svg viewBox=\"0 0 24 24\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>',\n    folder: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>',\n    crosshair: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg>',\n    play: '<svg viewBox=\"0 0 24 24\"><path d=\"M7 4l13 8-13 8z\"/></svg>',\n    pencil: '<svg viewBox=\"0 0 24 24\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2 2 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg>',\n    trash: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"/></svg>'\n  };\n  var state = { editing: null, trigger: \"\", targets: [{ kind: \"app\", value: \"\" }], actions: [], capturing: null };\n  var $ = function (id) { return document.getElementById(id); };\n\n  function showErr(msg) { var e = $(\"err\"); if (!msg) { e.style.display = \"none\"; return; } e.textContent = msg; e.style.display = \"block\"; }\n\n  // Storage shape (what main.js reads): { trigger, websites:[{url}], apps:[{path}], enabled }.\n  function toStored(trigger, targets, enabled) {\n    var websites = [], apps = [];\n    targets.forEach(function (t) {\n      var v = (t.value || \"\").trim(); if (!v) return;\n      if (t.kind === \"url\") websites.push({ url: v }); else apps.push({ path: v });\n    });\n    return { trigger: trigger, websites: websites, apps: apps, enabled: enabled !== false };\n  }\n  function toTargets(a) {\n    var out = [];\n    (a.apps || []).forEach(function (p) { if (p && p.path) out.push({ kind: \"app\", value: p.path }); });\n    (a.websites || []).forEach(function (w) { if (w && w.url) out.push({ kind: \"url\", value: w.url }); });\n    return out.length ? out : [{ kind: \"app\", value: \"\" }];\n  }\n  function chips(a) { return toTargets(a).filter(function (t) { return t.value; }); }\n\n  function load() {\n    g.settings.get(\"actions\").then(function (v) {\n      state.actions = Array.isArray(v) ? v : [];\n      renderList();\n    }).catch(function (e) { showErr(String(e && e.message || e)); });\n  }\n  function persist(next) {\n    state.actions = next;\n    renderList();\n    g.settings.set(\"actions\", next).catch(function (e) { showErr(String(e && e.message || e)); load(); });\n  }\n\n  function renderTargets() {\n    var box = $(\"targets\"); box.innerHTML = \"\";\n    state.targets.forEach(function (t, i) {\n      var row = document.createElement(\"div\"); row.className = \"target\";\n      var cap = state.capturing && state.capturing.i === i;\n      row.innerHTML =\n        '<div class=\"seg\">' +\n          '<button data-k=\"app\" class=\"' + (t.kind === \"app\" ? \"on\" : \"\") + '\">' + ICON.app + ' App</button>' +\n          '<button data-k=\"url\" class=\"' + (t.kind === \"url\" ? \"on\" : \"\") + '\">' + ICON.web + ' Web</button>' +\n        '</div>' +\n        '<input type=\"text\" value=\"' + esc(t.value) + '\" placeholder=\"' + (t.kind === \"app\" ? \"App path, e.g. C:\\\\\\\\…\\\\\\\\Code.exe\" : \"Website, e.g. github.com\") + '\" />' +\n        '<div class=\"tools\">' +\n          (cap ? '<span class=\"ic count\">' + state.capturing.n + '</span>'\n               : '<button class=\"ic\" data-a=\"capture\" title=\"Capture focused app\">' + ICON.crosshair + '</button>') +\n          (t.kind === \"app\" ? '<button class=\"ic\" data-a=\"browse\" title=\"Browse for an app\">' + ICON.folder + '</button>' : '') +\n          '<button class=\"ic\" data-a=\"remove\" title=\"Remove\">' + ICON.cross + '</button>' +\n        '</div>';\n      row.querySelectorAll(\".seg button\").forEach(function (b) {\n        b.onclick = function () { state.targets[i].kind = b.getAttribute(\"data-k\"); renderTargets(); };\n      });\n      row.querySelector(\"input\").oninput = function (e) { state.targets[i].value = e.target.value; };\n      row.querySelectorAll(\"[data-a]\").forEach(function (b) {\n        var a = b.getAttribute(\"data-a\");\n        b.onclick = function () {\n          if (a === \"remove\") { state.targets.splice(i, 1); if (!state.targets.length) state.targets.push({ kind: \"app\", value: \"\" }); renderTargets(); }\n          else if (a === \"browse\") browse(i);\n          else if (a === \"capture\") capture(i);\n        };\n      });\n      box.appendChild(row);\n    });\n  }\n\n  function browse(i) {\n    g.open.pickApp().then(function (p) { if (p) { state.targets[i].value = p; renderTargets(); } })\n      .catch(function (e) { showErr(String(e && e.message || e)); });\n  }\n  function capture(i) {\n    if (state.capturing) return;\n    var n = 3; state.capturing = { i: i, n: n }; renderTargets();\n    var tick = setInterval(function () {\n      n -= 1;\n      if (n > 0) { state.capturing = { i: i, n: n }; renderTargets(); return; }\n      clearInterval(tick); state.capturing = null;\n      g.focusedApp().then(function (app) {\n        if (!app) { showErr(\"Couldn't detect the focused app. Try again.\"); renderTargets(); return; }\n        if (app.urlHost) state.targets[i] = { kind: \"url\", value: app.urlHost };\n        else if (app.exePath) state.targets[i] = { kind: \"app\", value: app.exePath };\n        else showErr(\"Couldn't resolve a launchable path for \" + (app.name || app.exe || \"that app\") + \".\");\n        renderTargets();\n      }).catch(function (e) { showErr(String(e && e.message || e)); renderTargets(); });\n    }, 1000);\n  }\n\n  function test() {\n    showErr(\"\");\n    state.targets.forEach(function (t) {\n      var v = (t.value || \"\").trim(); if (!v) return;\n      if (t.kind === \"url\") g.open.url(v); else g.open.app(v);\n    });\n  }\n\n  function submit() {\n    showErr(\"\");\n    var trig = $(\"trigger\").value.trim();\n    if (!trig) { showErr(\"Enter a trigger phrase.\"); return; }\n    var hasTarget = state.targets.some(function (t) { return (t.value || \"\").trim(); });\n    if (!hasTarget) { showErr(\"Add at least one app or website.\"); return; }\n    var norm = trig.toLowerCase().replace(/[^a-z0-9]/g, \"\");\n    var clash = state.actions.some(function (a, idx) {\n      return idx !== state.editing && (a.trigger || \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\") === norm;\n    });\n    if (clash) { showErr('\"' + trig + '\" already uses that trigger.'); return; }\n    var enabled = state.editing != null ? (state.actions[state.editing].enabled !== false) : true;\n    var stored = toStored(trig, state.targets, enabled);\n    var next = state.actions.slice();\n    if (state.editing != null) next[state.editing] = stored; else next.push(stored);\n    resetForm();\n    persist(next);\n  }\n  function resetForm() {\n    state.editing = null; state.trigger = \"\"; state.targets = [{ kind: \"app\", value: \"\" }];\n    $(\"trigger\").value = \"\"; $(\"cancel\").style.display = \"none\"; $(\"submit\").textContent = \"Add action\";\n    renderTargets();\n  }\n  function edit(i) {\n    var a = state.actions[i];\n    state.editing = i; state.targets = toTargets(a);\n    $(\"trigger\").value = a.trigger || \"\"; $(\"cancel\").style.display = \"\";\n    $(\"submit\").textContent = \"Update action\"; renderTargets();\n    showErr(\"\");\n  }\n\n  function renderList() {\n    var box = $(\"list\");\n    if (!state.actions.length) { box.innerHTML = '<div class=\"empty\">No actions yet. Add one above to open apps or sites with your voice.</div>'; return; }\n    box.innerHTML = \"\";\n    state.actions.forEach(function (a, i) {\n      var on = a.enabled !== false;\n      var item = document.createElement(\"div\"); item.className = \"item\" + (on ? \"\" : \" off\");\n      var tg = chips(a).map(function (t) {\n        return '<span class=\"tgt\">' + (t.kind === \"app\" ? ICON.app : ICON.web) + '<span>' + esc(t.value) + '</span></span>';\n      }).join(\"\");\n      item.innerHTML =\n        '<span class=\"chip\">' + esc(a.trigger || \"\") + '</span>' +\n        '<span class=\"arrow\">→</span>' +\n        '<div class=\"tgts\">' + tg + '</div>' +\n        '<button class=\"ic\" data-a=\"run\" title=\"Run now\">' + ICON.play + '</button>' +\n        '<button class=\"sw ' + (on ? \"on\" : \"\") + '\" data-a=\"toggle\" title=\"Enable / disable\"></button>' +\n        '<button class=\"ic\" data-a=\"edit\" title=\"Edit\">' + ICON.pencil + '</button>' +\n        '<button class=\"ic\" data-a=\"del\" title=\"Delete\">' + ICON.trash + '</button>';\n      item.querySelectorAll(\"[data-a]\").forEach(function (b) {\n        var act = b.getAttribute(\"data-a\");\n        b.onclick = function () {\n          if (act === \"run\") { chips(a).forEach(function (t) { if (t.kind === \"url\") g.open.url(t.value); else g.open.app(t.value); }); }\n          else if (act === \"toggle\") { var n = state.actions.slice(); n[i] = Object.assign({}, a, { enabled: !on }); persist(n); }\n          else if (act === \"edit\") edit(i);\n          else if (act === \"del\") { if (state.editing === i) resetForm(); var n = state.actions.slice(); n.splice(i, 1); persist(n); }\n        };\n      });\n      box.appendChild(item);\n    });\n  }\n\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) { return ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c]; }); }\n\n  $(\"add-target\").onclick = function () { state.targets.push({ kind: \"app\", value: \"\" }); renderTargets(); };\n  $(\"test\").onclick = test;\n  $(\"submit\").onclick = submit;\n  $(\"cancel\").onclick = resetForm;\n\n  renderTargets();\n  load();\n})();\n</script>\n"
        }
      ]
    },
    "description": "Say a trigger word to open apps and websites, then have it stripped from what gets pasted. Its editor renders as a custom card right below the Snippets settings — no separate window. A worked example of the transform hook, the open:url / open:app / capture:app capabilities, and the custom settings card.",
    "entry_source": "// Voice Actions — the worker. Runs on the finalized transcript: matches the\r\n// user's configured triggers, opens their websites/apps, and returns the text\r\n// with the trigger removed.\r\n//\r\n// Config lives in the extension's declared settings (rendered natively in the\r\n// Snippets tab — no webview): `actions` is a list of\r\n//   { trigger, websites: [{ url }], apps: [{ path }] }.\r\n//\r\n// Security: this worker never launches anything on its own. `grain.open.url` is\r\n// scheme-allowlisted by the host; `grain.open.app` only launches an app the user\r\n// picked via the app-path control (which records approval). It merely relays the\r\n// user's configured rules.\r\n\r\nfunction normalize(s) {\r\n  return String(s || \"\").toLowerCase().trim();\r\n}\r\n\r\ngrain.onTransform(function (text) {\r\n  return grain.settings.get(\"actions\").then(function (actions) {\r\n    actions = Array.isArray(actions) ? actions : [];\r\n    if (!actions.length) return text;\r\n\r\n    var out = text;\r\n    var fired = [];\r\n    actions.forEach(function (a) {\r\n      if (!a || a.enabled === false) return;\r\n      var trigger = normalize(a.trigger);\r\n      if (!trigger) return;\r\n      var idx = out.toLowerCase().indexOf(trigger);\r\n      if (idx !== -1) {\r\n        out = out.slice(0, idx) + out.slice(idx + trigger.length);\r\n        fired.push(a);\r\n      }\r\n    });\r\n\r\n    // Fire-and-forget so a slow launch never blocks the paste path.\r\n    fired.forEach(function (a) {\r\n      (a.websites || []).forEach(function (w) {\r\n        if (w && w.url) {\r\n          try { grain.open.url(String(w.url)); } catch (e) {}\r\n        }\r\n      });\r\n      (a.apps || []).forEach(function (p) {\r\n        if (p && p.path) {\r\n          try { grain.open.app(String(p.path)); } catch (e) {}\r\n        }\r\n      });\r\n    });\r\n\r\n    return out.replace(/\\s+/g, \" \").trim();\r\n  });\r\n});\r\n",
    "grainApi": "^1.0",
    "id": "grain.voice-actions",
    "name": "Voice Actions",
    "permissions": [
      "transform:transcript",
      "open:url",
      "open:app",
      "capture:app",
      "settings"
    ],
    "repository": "https://github.com/Punit-Dethe/Grain-Extention",
    "tier": "scripted",
    "version": "1.0.0"
  },
  "payloads": {}
}
