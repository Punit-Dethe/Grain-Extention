{
  "manifest": {
    "activation": [
      "onTransform"
    ],
    "contributes": {
      "settings": [
        {
          "anchor": "context.after",
          "key": "modes-card",
          "kind": "panel",
          "label": "",
          "order": 10,
          "searchTerms": [
            "modes",
            "app mode",
            "context",
            "per app",
            "formatting"
          ],
          "uiSource": "<!-- App Modes — the custom settings card (SPEC §4.1 Level 3). Sandboxed iframe;\n     window.grain is the only channel out, every call capability-checked in Rust.\n     Stores rules under the extension's own `modes` setting, the shape main.js\n     reads: [{ id, name, match:{kind,value}, prompt, enabled }] -->\n<meta charset=\"utf-8\" />\n<style>\n  :root {\n    --paper: #faf8f3; --sunken: #efeae1; --raised: #ffffff;\n    --line: #e5dfd2; --ink: #17150f; --soft: #5b564c; --faint: #938d80;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #b4462f;\n  }\n  /* The host (Grain) tells us its theme via data-grain-theme, because a\n     sandboxed iframe's prefers-color-scheme reports the OPERATING SYSTEM — which\n     is the wrong answer whenever the OS and Grain's own theme disagree. The\n     media query stays as the fallback for a card opened outside Grain. */\n  @media (prefers-color-scheme: dark) {\n    :root {\n    --paper: #16140f; --sunken: #1e1b15; --raised: #201d16;\n    --line: #322d23; --ink: #f3efe6; --soft: #b7b0a2; --faint: #7d7668;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #e0765c;\n    }\n  }\n  :root[data-grain-theme=\"dark\"] {\n    --paper: #16140f; --sunken: #1e1b15; --raised: #201d16;\n    --line: #322d23; --ink: #f3efe6; --soft: #b7b0a2; --faint: #7d7668;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #e0765c;\n  }\n  :root[data-grain-theme=\"light\"] {\n    --paper: #faf8f3; --sunken: #efeae1; --raised: #ffffff;\n    --line: #e5dfd2; --ink: #17150f; --soft: #5b564c; --faint: #938d80;\n    --accent: #d8a43c; --accent-ink: #17150f; --danger: #b4462f;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body { font: 13px/1.45 -apple-system, \"Segoe UI\", Inter, system-ui, sans-serif; color: var(--ink); background: transparent; }\n  .card { background: var(--raised); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\n  .head { padding: 14px 16px 10px; }\n  .title { font-size: 14px; font-weight: 600; }\n  .sub { color: var(--soft); font-size: 12px; margin-top: 3px; }\n  .body { padding: 4px 16px 16px; display: flex; flex-direction: column; gap: 14px; }\n  label.fl { display: block; font-size: 11px; font-weight: 600; letter-spacing: .02em; color: var(--soft); margin-bottom: 6px; }\n  input.txt, textarea.txt {\n    width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 9px;\n    background: var(--sunken); color: var(--ink); font: inherit; outline: none; resize: vertical;\n  }\n  input.txt:focus, textarea.txt:focus { border-color: var(--accent); }\n  .applies { display: flex; align-items: center; gap: 8px; }\n  .seg { display: flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; flex: none; }\n  .seg button { display: flex; align-items: center; gap: 4px; padding: 7px 10px; font: inherit; font-size: 12px; border: 0; border-right: 1px solid var(--line); background: transparent; color: var(--soft); cursor: pointer; }\n  .seg button:last-child { border-right: 0; }\n  .seg button.on { background: var(--accent); color: var(--accent-ink); font-weight: 600; }\n  .btn { padding: 7px 12px; border-radius: 9px; border: 1px solid var(--line); background: var(--sunken); color: var(--ink); font: inherit; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }\n  .btn:hover { border-color: var(--faint); }\n  .btn[disabled] { opacity: .5; cursor: not-allowed; }\n  .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }\n  .tpls { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }\n  .tpl { padding: 3px 9px; border-radius: 7px; font-size: 12px; border: 1px solid var(--line); background: transparent; color: var(--soft); cursor: pointer; }\n  .tpl:hover { color: var(--ink); border-color: var(--accent); }\n  .head-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 6px; }\n  .row-actions { display: flex; justify-content: flex-end; gap: 8px; }\n  .list { border-top: 1px solid var(--line); }\n  .empty { padding: 22px 16px; text-align: center; color: var(--faint); font-size: 12px; }\n  .item { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-top: 1px solid var(--line); }\n  .item:first-child { border-top: 0; }\n  .item.off { opacity: .5; }\n  .grow { flex: 1; min-width: 0; }\n  .name-row { display: flex; align-items: center; gap: 8px; min-width: 0; }\n  .name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .match { display: inline-flex; align-items: center; gap: 4px; flex: none; font: 11.5px ui-monospace, monospace; color: var(--soft); background: var(--sunken); border: 1px solid var(--line); border-radius: 6px; padding: 2px 7px; max-width: 180px; }\n  .match span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .prompt { margin: 2px 0 0; font-size: 12px; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .ic { border: 0; background: transparent; color: var(--soft); cursor: pointer; padding: 6px; border-radius: 7px; display: inline-flex; line-height: 0; }\n  .ic:hover { color: var(--accent); background: rgba(216,164,60,.12); }\n  .sw { width: 32px; height: 18px; border-radius: 999px; background: #0a0a0a; border: 0; position: relative; cursor: pointer; flex: none; }\n  .sw::after { content: \"\"; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #f0ebe3; transition: transform .18s; }\n  .sw.on { background: var(--accent); }\n  .sw.on::after { transform: translateX(14px); }\n  .tools { display: flex; gap: 2px; }\n  .err { margin: 0 16px; padding: 7px 10px; border-radius: 8px; background: rgba(180,70,47,.12); color: var(--danger); font-size: 12px; }\n  svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n</style>\n\n<div class=\"card\">\n  <div class=\"head\">\n    <div class=\"title\">Modes</div>\n    <div class=\"sub\">Your own instructions applied only inside a specific app or website (e.g. an “X post” mode on x.com). When the focused app matches, the transcript is reformatted with that mode's prompt.</div>\n  </div>\n  <div id=\"err\" class=\"err\" style=\"display:none\"></div>\n  <div class=\"body\">\n    <div>\n      <label class=\"fl\">Applies in</label>\n      <div class=\"applies\">\n        <div class=\"seg\">\n          <button data-k=\"process\" class=\"on\" id=\"k-app\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18\"/></svg> App</button>\n          <button data-k=\"url_host\" id=\"k-web\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18\"/></svg> Web</button>\n        </div>\n        <input id=\"match\" class=\"txt\" type=\"text\" placeholder=\"App executable, e.g. Code, slack, cursor\" />\n        <button class=\"btn\" id=\"capture\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg> <span id=\"cap-label\">Capture</span></button>\n      </div>\n    </div>\n    <div>\n      <label class=\"fl\" for=\"name\">Mode name</label>\n      <input id=\"name\" class=\"txt\" type=\"text\" placeholder=\"e.g. X post, Work email\" />\n    </div>\n    <div>\n      <div class=\"head-row\">\n        <label class=\"fl\" for=\"prompt\" style=\"margin:0\">Instructions</label>\n        <div class=\"tpls\" id=\"tpls\"></div>\n      </div>\n      <textarea id=\"prompt\" class=\"txt\" rows=\"4\" placeholder=\"Instructions for this app/site. e.g. 'Rewrite as a tweet under 280 characters in my voice.'\"></textarea>\n    </div>\n    <div class=\"row-actions\">\n      <button class=\"btn\" id=\"cancel\" style=\"display:none\">Cancel</button>\n      <button class=\"btn primary\" id=\"submit\">Add mode</button>\n    </div>\n  </div>\n  <div id=\"list\" class=\"list\"></div>\n</div>\n\n<script>\n(function () {\n  var g = window.grain;\n  var ICON = {\n    app: '<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>',\n    web: '<svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18\"/></svg>',\n    pencil: '<svg viewBox=\"0 0 24 24\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2 2 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg>',\n    trash: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14\"/></svg>'\n  };\n  var TEMPLATES = [\n    { name: \"Email\", prompt: \"Rewrite this dictated transcript as a clear, professional email body. Fix grammar, capitalization, and punctuation, and organize it into natural paragraphs with a polite, professional tone. Do NOT invent a greeting, sign-off, or subject line, and do not add anything that was not said. Keep the original language. Return only the email body.\" },\n    { name: \"Coding\", prompt: \"Format this dictated transcript as a concise technical message. Correct spoken programming terms to their real form (e.g. \\\"snake case\\\" -> snake_case, \\\"use effect\\\" -> useEffect), wrap identifiers, symbols, and code in backticks, and keep it terse. Do not implement or explain anything that was not asked. Keep the original language. Return only the cleaned text.\" },\n    { name: \"X post\", prompt: \"Rewrite this dictated transcript as a single social post in the user's own voice. Keep it under 280 characters, casual and punchy. Do not add hashtags or emoji unless they were dictated. Return only the post text.\" },\n    { name: \"Chat\", prompt: \"Lightly clean this dictated transcript for a casual chat message. Fix obvious spelling and punctuation errors but keep the user's casual tone, slang, and phrasing - do not formalize or restructure. Keep the original language. Return only the message.\" }\n  ];\n  var state = { editing: null, kind: \"process\", modes: [], capturing: false };\n  var $ = function (id) { return document.getElementById(id); };\n  function showErr(m) { var e = $(\"err\"); if (!m) { e.style.display = \"none\"; return; } e.textContent = m; e.style.display = \"block\"; }\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) { return ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" })[c]; }); }\n\n  function setKind(k) {\n    state.kind = k;\n    $(\"k-app\").classList.toggle(\"on\", k === \"process\");\n    $(\"k-web\").classList.toggle(\"on\", k === \"url_host\");\n    $(\"match\").placeholder = k === \"process\" ? \"App executable, e.g. Code, slack, cursor\" : \"Website host, e.g. x.com, mail.google.com\";\n  }\n  function normValue(kind, v) {\n    v = (v || \"\").trim();\n    return kind === \"process\"\n      ? v.replace(/\\.exe$/i, \"\").toLowerCase()\n      : v.replace(/^https?:\\/\\//i, \"\").replace(/\\/.*$/, \"\").replace(/^www\\./i, \"\").toLowerCase();\n  }\n\n  function load() {\n    g.settings.get(\"modes\").then(function (v) { state.modes = Array.isArray(v) ? v : []; renderList(); })\n      .catch(function (e) { showErr(String(e && e.message || e)); });\n  }\n  function persist(next) {\n    state.modes = next; renderList();\n    g.settings.set(\"modes\", next).catch(function (e) { showErr(String(e && e.message || e)); load(); });\n  }\n\n  function capture() {\n    if (state.capturing) return;\n    state.capturing = true;\n    var n = 3; $(\"cap-label\").textContent = \"Switch to your app… \" + n; $(\"capture\").disabled = true;\n    var tick = setInterval(function () {\n      n -= 1;\n      if (n > 0) { $(\"cap-label\").textContent = \"Switch to your app… \" + n; return; }\n      clearInterval(tick); state.capturing = false; $(\"capture\").disabled = false; $(\"cap-label\").textContent = \"Capture\";\n      g.focusedApp().then(function (app) {\n        if (!app) { showErr(\"Couldn't detect the focused app. Try again.\"); return; }\n        showErr(\"\");\n        if (app.urlHost) { setKind(\"url_host\"); $(\"match\").value = app.urlHost; if (!$(\"name\").value.trim()) $(\"name\").value = app.urlHost; }\n        else if (app.exe) { setKind(\"process\"); $(\"match\").value = app.exe; if (!$(\"name\").value.trim()) $(\"name\").value = app.name || app.exe; }\n        else showErr(\"Couldn't resolve the focused app.\");\n      }).catch(function (e) { showErr(String(e && e.message || e)); });\n    }, 1000);\n  }\n\n  function submit() {\n    showErr(\"\");\n    var name = $(\"name\").value.trim();\n    var raw = $(\"match\").value.trim();\n    var prompt = $(\"prompt\").value.trim();\n    if (!name) { showErr(\"Name your mode.\"); return; }\n    if (!raw) { showErr(\"Choose the app or website it applies in.\"); return; }\n    if (!prompt) { showErr(\"Add the instructions for this mode.\"); return; }\n    var value = normValue(state.kind, raw);\n    var mode = { name: name, match: { kind: state.kind, value: value }, prompt: prompt };\n    var next = state.modes.slice();\n    if (state.editing != null) {\n      next[state.editing] = Object.assign({}, state.modes[state.editing], mode);\n    } else {\n      mode.id = (self.crypto && crypto.randomUUID) ? crypto.randomUUID() : String(Date.now()) + Math.random();\n      mode.enabled = true;\n      next.push(mode);\n    }\n    resetForm();\n    persist(next);\n  }\n  function resetForm() {\n    state.editing = null; setKind(\"process\");\n    $(\"name\").value = \"\"; $(\"match\").value = \"\"; $(\"prompt\").value = \"\";\n    $(\"cancel\").style.display = \"none\"; $(\"submit\").textContent = \"Add mode\"; showErr(\"\");\n  }\n  function edit(i) {\n    var m = state.modes[i]; state.editing = i;\n    $(\"name\").value = m.name || \"\"; setKind(m.match && m.match.kind === \"url_host\" ? \"url_host\" : \"process\");\n    $(\"match\").value = (m.match && m.match.value) || \"\"; $(\"prompt\").value = m.prompt || \"\";\n    $(\"cancel\").style.display = \"\"; $(\"submit\").textContent = \"Update mode\"; showErr(\"\");\n  }\n\n  function renderList() {\n    var box = $(\"list\");\n    if (!state.modes.length) { box.innerHTML = '<div class=\"empty\">No modes yet. Add one above to apply your own formatting in a specific app or website.</div>'; return; }\n    box.innerHTML = \"\";\n    state.modes.forEach(function (m, i) {\n      var on = m.enabled !== false;\n      var isWeb = m.match && m.match.kind === \"url_host\";\n      var item = document.createElement(\"div\"); item.className = \"item\" + (on ? \"\" : \" off\");\n      item.innerHTML =\n        '<div class=\"grow\">' +\n          '<div class=\"name-row\">' +\n            '<span class=\"name\">' + esc(m.name || \"\") + '</span>' +\n            '<span class=\"match\">' + (isWeb ? ICON.web : ICON.app) + '<span>' + esc(m.match && m.match.value) + '</span></span>' +\n          '</div>' +\n          '<p class=\"prompt\">' + esc(m.prompt || \"\") + '</p>' +\n        '</div>' +\n        '<button class=\"sw ' + (on ? \"on\" : \"\") + '\" data-a=\"toggle\" title=\"Enable / disable\"></button>' +\n        '<div class=\"tools\">' +\n          '<button class=\"ic\" data-a=\"edit\" title=\"Edit\">' + ICON.pencil + '</button>' +\n          '<button class=\"ic\" data-a=\"del\" title=\"Delete\">' + ICON.trash + '</button>' +\n        '</div>';\n      item.querySelectorAll(\"[data-a]\").forEach(function (b) {\n        var a = b.getAttribute(\"data-a\");\n        b.onclick = function () {\n          if (a === \"toggle\") { var n = state.modes.slice(); n[i] = Object.assign({}, m, { enabled: !on }); persist(n); }\n          else if (a === \"edit\") edit(i);\n          else if (a === \"del\") { if (state.editing === i) resetForm(); var n = state.modes.slice(); n.splice(i, 1); persist(n); }\n        };\n      });\n      box.appendChild(item);\n    });\n  }\n\n  // Templates\n  var tp = $(\"tpls\");\n  TEMPLATES.forEach(function (t) {\n    var b = document.createElement(\"button\"); b.className = \"tpl\"; b.textContent = t.name;\n    b.onclick = function () { if (!$(\"name\").value.trim()) $(\"name\").value = t.name; $(\"prompt\").value = t.prompt; };\n    tp.appendChild(b);\n  });\n  $(\"k-app\").onclick = function () { setKind(\"process\"); };\n  $(\"k-web\").onclick = function () { setKind(\"url_host\"); };\n  $(\"capture\").onclick = capture;\n  $(\"submit\").onclick = submit;\n  $(\"cancel\").onclick = resetForm;\n  load();\n})();\n</script>\n"
        }
      ]
    },
    "description": "Your own formatting instructions, applied only inside a specific app or website — an 'X post' mode on x.com, a 'Work email' mode in Outlook. When the focused app matches, the transcript is reformatted with that mode's prompt. Its editor renders as a custom card right below the Context settings. A worked example of the transform hook with capture:app + llm.",
    "entry_source": "// App Modes — the worker. On the finalized transcript, if the FOREGROUND app\n// matches one of the user's modes, reformat the transcript with that mode's\n// instructions via the configured AI provider. No match → the text is returned\n// unchanged (and no LLM call is made).\n//\n// Config lives in the extension's own `modes` setting (edited by the custom card\n// in config.html), the shape:\n//   [{ id, name, match: { kind: \"process\" | \"url_host\", value }, prompt, enabled }]\n//\n// Security: capture:app only reveals which app is focused; llm sends text to the\n// user's own configured provider. Both are grants the user approved.\n\nfunction normProc(s) {\n  return String(s || \"\").toLowerCase().replace(/\\.exe$/, \"\").trim();\n}\nfunction normHost(s) {\n  return String(s || \"\")\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, \"\")\n    .replace(/^www\\./, \"\")\n    .replace(/\\/.*$/, \"\")\n    .trim();\n}\n\ngrain.onTransform(function (text) {\n  if (!text || !text.trim()) return text;\n  return grain.settings.get(\"modes\").then(function (modes) {\n    modes = Array.isArray(modes) ? modes : [];\n    var active = modes.filter(function (m) {\n      return m && m.enabled !== false && m.prompt && m.match && m.match.value;\n    });\n    if (!active.length) return text;\n\n    // Only now do we look at the foreground app — nothing to match against\n    // otherwise.\n    return grain.focusedApp().then(function (app) {\n      if (!app) return text;\n      var mode = null;\n      for (var i = 0; i < active.length; i++) {\n        var m = active[i];\n        var hit =\n          m.match.kind === \"url_host\"\n            ? app.urlHost && normHost(app.urlHost) === normHost(m.match.value)\n            : app.exe && normProc(app.exe) === normProc(m.match.value);\n        if (hit) { mode = m; break; }\n      }\n      if (!mode) return text;\n\n      var prompt = mode.prompt + \"\\n\\nTranscript:\\n\" + text;\n      return grain.llm.complete(prompt).then(function (r) {\n        var out = r && r.text != null ? r.text : (typeof r === \"string\" ? r : null);\n        return out && String(out).trim() ? String(out).trim() : text;\n      }).catch(function () { return text; });\n    }).catch(function () { return text; });\n  }).catch(function () { return text; });\n});\n",
    "grainApi": "^1.0",
    "id": "grain.app-modes",
    "name": "App Modes",
    "permissions": [
      "transform:transcript",
      "capture:app",
      "llm",
      "settings"
    ],
    "repository": "https://github.com/Punit-Dethe/Grain-Extention",
    "tier": "scripted",
    "version": "1.0.0"
  },
  "payloads": {}
}
